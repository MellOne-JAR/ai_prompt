{
  "entities": {
    "Prompt": {
      "title": "Prompt",
      "description": "A curated prompt item with title, category, multiline content, and creation timestamp",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Prompt title",
          "minLength": 1,
          "maxLength": 100
        },
        "category": {
          "type": "string",
          "description": "Prompt category",
          "enum": ["사진 합성", "스타일 변환", "캐릭터·포스터"]
        },
        "content": {
          "type": "string",
          "description": "Full prompt body preserving line breaks (supports 1,000+ characters up to 10,000)",
          "minLength": 1,
          "maxLength": 10000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        }
      },
      "required": ["title", "category", "content", "createdAt"]
    }
  },
  "firestore": {
    "/prompts/{promptId}": {
      "schema": {
        "$ref": "#/entities/Prompt"
      },
      "description": "Public prompt catalog readable by guests; create, update, and delete restricted to verified admin"
    }
  }
}
